# MediBook Next.js backend environment.
# Copy this file to .env and set real values. Never commit .env (Rule 6).

# --- PostgreSQL (Neon, via Prisma) ---
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# --- Authentication ---
# Secret used to sign JWT access/refresh tokens (server-side only — never
# expose with a NEXT_PUBLIC_ prefix). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me"
# Token lifetimes.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
PASSWORD_RESET_TOKEN_HOURS=2

# --- API ---
APP_VERSION=0.1.0
API_PAGE_SIZE=20
# Set to "true" to disable rate limiting (the test suite does this).
THROTTLE_DISABLED=false

# --- Server ---
PORT=8000
# How often (minutes) due appointment reminders are dispatched in-process.
# Set to 0 to disable and run `npm run reminders` from cron instead.
REMINDERS_INTERVAL_MINUTES=15

# --- Media ---
# Where uploaded files (profile images, health records, blog images) are
# stored. Relative paths resolve against the next-app directory.
MEDIA_ROOT=uploads

# --- Email ---
# Dev console transport: password-reset mails are printed to the server
# console instead of being sent.
EMAIL_TRANSPORT=console
DEFAULT_FROM_EMAIL="MediBook <no-reply@medibook.local>"

# --- Social OAuth (optional) ---
APPLE_CLIENT_ID=
