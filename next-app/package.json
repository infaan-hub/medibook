{
  "name": "medibook-next",
  "version": "0.1.0",
  "private": true,
  "description": "MediBook — Next.js full-stack (API + PWA UI) + Prisma + PostgreSQL",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "node server.js production",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "db:import": "node scripts/import-sqlite.mjs",
    "reminders": "node scripts/send-reminders.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "axios": "^1.20.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^6.0.0",
    "lucide-react": "^1.47.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "prisma": "^6.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
