# MediBook backend environment variables.
# Copy this file to backend/.env and set real values. Never commit backend/.env (Rule 6).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=medibook
POSTGRES_USER=medibook_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- API / JWT ---
API_PAGE_SIZE=20
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- CORS (React dev server + installed PWA origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production only (used when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_CSRF_TRUSTED_ORIGINS=