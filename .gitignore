# MediBook — repository-wide ignores

# --- Node / React ---
node_modules/
dist/
.vite/
*.local

# --- Environment & secrets (Rule 6: never commit secrets) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Media / static uploaded by users ---
next-app/uploads/

# --- Build output (regenerated by `npm run build`; never commit) ---
# Both apps build into their own `.next`. These were tracked by accident, which
# is what triggers Vercel's "You should not upload the .next directory" warning
# and turns routine commits into hundreds of binary churn entries.
.next/
next-app/.next/
frontend/.next/
*.tsbuildinfo

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs ---
*.log
npm-debug.log*

# --- Report QA artifacts (regenerated by npm test / scripts/screenshot-pdf.mjs) ---
next-app/reports/_shots/
next-app/reports/_smoke-*.pdf