# MediBook — repository-wide ignores

# --- Node / React ---
node_modules/
dist/
.vite/
*.local

# --- Environment & secrets (Rule 6: never commit secrets) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Media / static uploaded by users ---
next-app/uploads/
next-app/.next/

# --- Desktop app installers staged for the in-app download link ---
# Build with `npm run dist` in desktop/, then copy the setup .exe here.
frontend/public/downloads/*.exe
next-app/public/downloads/*.exe
frontend/public/downloads/*.msi
next-app/public/downloads/*.msi

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs ---
*.log
npm-debug.log*