# MediBook — repository-wide ignores

# --- Node / React ---
node_modules/
dist/
.vite/
*.local

# --- Environment & secrets (Rule 6: never commit secrets) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Media / static uploaded by users ---
next-app/uploads/
next-app/.next/

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs ---
*.log
npm-debug.log*