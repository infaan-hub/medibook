# MediBook environment variables (Next.js).
# Copy this file to frontend/.env and adjust per environment. Never commit frontend/.env.
#
# This app serves BOTH the UI and the API (app/api/**), so it needs the client
# vars below AND the server-only secrets that the API handlers read. A deploy
# with only the NEXT_PUBLIC_* vars set will register every route and then fail
# at runtime — most routes 500 on a missing DATABASE_URL, and every sign-in
# fails without AUTH_SECRET.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are
# therefore public. Everything under "Server-only" must never be prefixed with
# NEXT_PUBLIC_.

# ---------------------------------------------------------------- client bundle

# API base URL. Leave as /api now that the API is served from this same app.
# Only point it at a different origin if the API still lives elsewhere.
NEXT_PUBLIC_API_BASE_URL=/api

# Optional: absolute realtime base when the WebSocket/SSE endpoint is NOT
# same-origin. Empty (recommended) = same origin: `node server.js` serves
# /ws/notifications/ (WebSocket) and /ws/notifications/sse/ (SSE fallback)
# right next to the UI, and a serverless host answers the SSE route instead.
# Accepts ws://, wss://, http://, https:// or a bare host — the client
# normalises it, so an https:// value can never become "wss://https//host".
# NEXT_PUBLIC_WS_URL=wss://ws.example.com

# Normally leave empty — the app fetches the public key from the API.

# Google OAuth Web application Client ID (public — safe to ship to the browser).
# Format: <id>-<random>.apps.googleusercontent.com
# Obtain from Google Cloud Console → APIs & Services → Credentials.
# The Client SECRET is intentionally absent: sign-in uses Google Identity
# Services (id_token) verified server-side, which needs no secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- server-only

# REQUIRED. PostgreSQL connection string used by Prisma. Every DB-backed route
# fails without it.
# DATABASE_URL=postgresql://user:pass@host:5432/medibook

# REQUIRED. HMAC key that signs access/refresh tokens (lib/jwt.ts). Empty means
# tokens cannot be verified, so no one can stay signed in. Use a long random
# value and never reuse it across environments.
# AUTH_SECRET=

# Token lifetimes, in minutes / days / hours respectively.
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7
# PASSWORD_RESET_TOKEN_HOURS=2

# Expected audience for Google id_tokens (services/social.service.ts). Set this
# to the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID to enforce the audience
# check; when unset the assertion is skipped.
# GOOGLE_CLIENT_ID=

# Shared secret required by POST/GET /api/cron/reminders/ via the x-cron-secret
# header. Unset means the reminders endpoint refuses every call.
# CRON_SECRET=

# HTTP port for `node server.js` (dev and `node server.js production`).
# PORT=3000

# In-process reminder scheduler started by instrumentation.ts — only reliable on
# a long-running host (`node server.js`). Set to 0 on serverless and rely on
# the cron endpoint / vercel.json instead.
# REMINDERS_INTERVAL_MINUTES=15

# When any of the three is missing, push notifications are disabled — the rest
# of the app keeps working.

# Outbound mail. "console" (default) logs password-reset mails instead of
# sending them, which is fine for local work but not for real users.
# EMAIL_TRANSPORT=console

# Report rendering. Defaults to the MediBook Zanzibar timezone.
# REPORT_TIMEZONE=Africa/Nairobi

# Pagination default for list endpoints.
# API_PAGE_SIZE=20

# Upload ceilings in bytes (profile images / health-record documents).
# MAX_IMAGE_SIZE=5242880
# MAX_FILE_SIZE=15728640

# Set to "true" to disable rate limiting (test/CI only — never in production).
# THROTTLE_DISABLED=false

# Surfaces in GET /api/health/ so a deploy can be identified.
# APP_VERSION=0.1.0

