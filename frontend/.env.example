# MediBook frontend environment variables (Next.js).
# Copy this file to frontend/.env and adjust per environment. Never commit frontend/.env.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.

# Backend API base URL (must include the /api prefix)
NEXT_PUBLIC_API_BASE_URL=/api

# Optional: absolute WebSocket base when the realtime server is NOT same-origin.
# Dev: set to the backend origin so the browser opens WS on :8000
# (Next.js rewrites do not proxy WebSockets).
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
# Production example (separate WS host): wss://ws.example.com

# Optional: only if GET /api/push/vapid-public-key/ is unavailable offline.
# Normally leave empty — the app fetches the public key from the backend.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Leave unset to use window.location.origin.
# NEXT_PUBLIC_APPLE_REDIRECT_URI=
