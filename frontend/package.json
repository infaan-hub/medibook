{
  "name": "medibook-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "MediBook frontend - Next.js installable PWA",
  "scripts": {
    "dev": "node server.js",
    "build": "prisma generate && next build",
    "start": "node server.js production",
    "dev:next": "next dev",
    "start:next": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "probe:push": "vitest run --config vitest.probe.config.ts --disable-console-intercept",
    "probe:broadcast": "vitest run --config vitest.probe.config.ts tests/probe/broadcast.test.ts --disable-console-intercept",
    "smoke:notifications": "node scripts/smoke-notifications.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "axios": "^1.20.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^6.0.0",
    "lucide-react": "^1.47.0",
    "next": "^15.5.0",
    "pdfkit": "^0.15.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "iconv-lite": "^0.7.3",
    "jsdom": "^29.1.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.5.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}

